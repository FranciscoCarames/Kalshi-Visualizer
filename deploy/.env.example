# Copy to /etc/kalshi-dashboard.env, then `chmod 640` + `chown root:kalshi-dashboard`.
# NEVER commit a real secret — point at your secret store. Generate a secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"

API_HOST=0.0.0.0
API_PORT=8000

# REQUIRED on a non-loopback bind — serve.py refuses to start without it (the dashboard has no auth and
# the NiceGUI session cookie is signed with this). Loopback (127.0.0.1) does not need it.
NICEGUI_STORAGE_SECRET=__SET_ME__

# Snapshot DB on LOCAL disk (never NFS), writable by the kalshi-dashboard user.
SNAPSHOT_DB_PATH=/var/lib/kalshi-dashboard/snapshots.db

# Headless 24/7: set 0 so the in-process auto-scan keeps running with NO browser connected. Leave unset
# (or 1) to pause background scanning while no viewer is watching (the interactive default).
AUTO_SCAN_PAUSE_WHEN_IDLE=0

# Optional: when set, POST /scan requires `X-Scan-Token: <value>` (401 otherwise). The scan.sh wrapper
# sends the header automatically when this is set; leave it unset to allow open scan triggering on a
# trusted LAN.
# SCAN_TOKEN=__SET_ME__

# Optional trusted-LAN escape: bind non-loopback with the dev-fallback secret (loud warning). Do NOT use
# for anything left running.
# ALLOW_DEV_STORAGE_SECRET_ON_LAN=1
