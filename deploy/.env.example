# Copy to /etc/kalshi-dashboard.env, then `chmod 640` + `chown root:kalshi-dashboard`.
# NEVER commit a real secret — point at your secret store. Generate a secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"

API_HOST=0.0.0.0
API_PORT=8000

# REQUIRED on a non-loopback bind — serve.py refuses to start without it (the dashboard has no auth and
# the NiceGUI session cookie is signed with this). Loopback (127.0.0.1) does not need it.
NICEGUI_STORAGE_SECRET=__SET_ME__

# Snapshot DB on LOCAL disk (never NFS), writable by the kalshi-dashboard user.
SNAPSHOT_DB_PATH=/var/lib/kalshi-dashboard/snapshots.db

# Headless 24/7. A non-loopback bind (API_HOST != 127.0.0.1 — i.e. any real server/LAN deploy) ALREADY
# defaults to 24/7 scanning (no idle pause), so this line is optional belt-and-braces. Set 1 to force the
# interactive "pause while no viewer is watching" mode even on a server; loopback dev defaults to pause.
AUTO_SCAN_PAUSE_WHEN_IDLE=0

# Optional: when set, POST /scan requires `X-Scan-Token: <value>` (401 otherwise). The scan.sh wrapper
# sends the header automatically when this is set; leave it unset to allow open scan triggering on a
# trusted LAN.
# SCAN_TOKEN=__SET_ME__

# Optional trusted-LAN escape: bind non-loopback with the dev-fallback secret (loud warning). Do NOT use
# for anything left running.
# ALLOW_DEV_STORAGE_SECRET_ON_LAN=1

# --- Real-time live feed (Stage 2) — EXCHANGE credentials. AUTO-DETECTED ----------------------------------
# Leave these unset to run REST-only (the default). Set BOTH a key id and a key (path OR inline) and the app
# AUTO-ARMS real-time mode at boot IF the key loads as a valid RSA private key; an invalid/missing key just
# stays REST-only (it never crashes). `KALSHI_LIVE_ENABLED=0` is an explicit kill switch.
# The .pem is your Kalshi RSA PRIVATE key; the id is the access-key id Kalshi shows next to it.
# KALSHI_API_KEY_ID=__SET_ME__
# KALSHI_PRIVATE_KEY_PATH=/etc/kalshi-dashboard/kalshi_key.pem   # chmod 600, owned by the service user
# Inline alternative (single line, literal \n between PEM lines) instead of a file path:
# KALSHI_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
# Stage 2D opt-in (let live-derived rows rank Actionable; still per-leg gated). Omit/0 = Stage 2C display.
# KALSHI_LIVE_ACTIONABILITY=0
# Explicit kill switch (force REST-only even if a valid key is present):
# KALSHI_LIVE_ENABLED=0
