# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Secrets / credentials (never commit) — Kalshi API key id + RSA private key
.env
*.pem
.streamlit/secrets.toml

# Snapshot store (Stage 1) — local opportunity-history SQLite DB
*.db
snapshots.db
# Per-user auth store (auth_store.py) — credentials; covered by *.db but listed explicitly so it is never
# committed even if the *.db rule is ever narrowed.
auth.db
# WAL sidecar files (v3 enables WAL mode) — gitignore has no inline comments, so keep these bare:
*.db-wal
*.db-shm
# pre-migration backups (store._backup_before_migration)
*.pre-v*-backup

# OS / editor
.DS_Store
.vscode/
.idea/

# Claude Code: share project config across machines (settings.json, rules/, memory/, hooks).
# Keep ONLY the machine-local pieces out of git:
.claude/settings.local.json
# Auto-memory lock artifacts (the *.md memory notes ARE tracked and shared on purpose)
.claude/memory/.*.lock

# Scratch / temp working dirs (audits, throwaway docs) — never tracked
.codex_tmp/
# Playwright MCP browser artifacts (snapshots, console logs, screenshots) — session scratch, never tracked
.playwright-mcp/
# Session scratch: boot logs + screenshots produced while verifying (never tracked)
serve_*.log
*.err.log
# Conditional-blend dark validator output — throwaway forward-test CSV, never tracked
conditional_blend_samples.csv

# Local kss planning shell (topics, milestones, codebase snapshots) — keep out of the repo
.kss/

# Scratch / throwaway — put disposable working files in scratch/ (gitignored) instead of the repo root,
# so the working tree stays clean and explicit `git add <paths>` is safe (mechanizes the old
# "never git add -A" habit). See scratch/README.md.
/scratch/*
!/scratch/README.md
# Stale compaction backups + one-off diagnostic/audit dumps produced during verification
*.pre-compact-backup
/diag*.json
/feed_qa*.json
/backlog_out.json
# Root-level screenshots/mockups (real frontend assets live under frontend/, never the repo root)
/*.png
/*.jpeg
/*.jpg
