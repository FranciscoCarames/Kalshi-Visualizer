# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Secrets / credentials (never commit) — Kalshi API key id + RSA private key
.env
*.pem
.streamlit/secrets.toml

# Snapshot store (Stage 1) — local opportunity-history SQLite DB
*.db
snapshots.db
# WAL sidecar files (v3 enables WAL mode) — gitignore has no inline comments, so keep these bare:
*.db-wal
*.db-shm
# pre-migration backups (store._backup_before_migration)
*.pre-v*-backup

# OS / editor
.DS_Store
.vscode/
.idea/

# Local Claude Code session settings
.claude/

# Scratch / temp working dirs (audits, throwaway docs) — never tracked
.codex_tmp/

# Local kss planning shell (topics, milestones, codebase snapshots) — keep out of the repo
.kss/
